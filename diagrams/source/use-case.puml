@startuml use-case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Family" as Family
actor "Pool Organiser" as Organizer
actor "Supplier" as Supplier
actor "Retailer / Bakery" as Shop
actor "Administrator" as Admin
actor "Kaspi QR" as Kaspi <<system>>

Organizer --|> Family

rectangle "Collective Food Purchasing System" {
  usecase "Register and\nselect district" as UC1
  usecase "Browse catalogue" as UC2
  usecase "Join pool" as UC3
  usecase "Calculate family share" as UC4
  usecase "Pay share by QR" as UC5
  usecase "Find pick-up point" as UC6
  usecase "Reserve surplus item" as UC7
  usecase "Apply for\nsocial status" as UC8

  usecase "Create pool" as UC9
  usecase "Confirm order\nhand-over" as UC10

  usecase "Publish products\nand wholesale prices" as UC11
  usecase "Receive combined order" as UC12
  usecase "View demand forecast" as UC13

  usecase "Publish near-expiry\nproduct" as UC14

  usecase "Verify social status" as UC15
  usecase "Moderate suppliers" as UC16
}

Family --> UC1
Family --> UC2
Family --> UC3
Family --> UC6
Family --> UC7
Family --> UC8

Organizer --> UC9
Organizer --> UC10

Supplier --> UC11
Supplier --> UC12
Supplier --> UC13

Shop --> UC14
Shop --> UC13

Admin --> UC15
Admin --> UC16

UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC9 ..> UC4 : <<include>>
UC5 --> Kaspi
UC5 ..> UC7 : <<extend>>

@enduml
