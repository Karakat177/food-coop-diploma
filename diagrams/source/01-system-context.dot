// DIP-9 System Context Diagram
// Project: Information system for optimizing collective food purchasing and food redistribution
// Render: dot -Tpng -Gdpi=200 01-system-context.dot -o ../export/01-system-context.png
// Interaction numbers (1-9) are explained in docs/07-architecture.md, section "System context".

digraph SystemContext {
    graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.6, fontname="Helvetica",
           label=<<b>System Context Diagram — Food Coop Platform</b>>, labelloc=t, fontsize=20, pad=0.4]
    node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", margin="0.2,0.12"]
    edge  [fontname="Helvetica", fontsize=10, color="#555555", fontcolor="#333333", arrowsize=0.8]

    subgraph cluster_users {
        label=<<b>Users</b>>; fontsize=13; style="rounded,dashed"; color="#9DB7D8"; fontcolor="#2F6DB5"
        node [fillcolor="#E8F1FB", color="#2F6DB5", fontcolor="#0B2545", width=2.4]
        FAM  [label=<<b>Family</b><br/><font point-size="10">participant: joins pools,<br/>pays share, reserves food</font>>]
        ORG  [label=<<b>Pool Organiser</b><br/><font point-size="10">building representative / OSI / KSK,<br/>acts as the pick-up point</font>>]
        SUP  [label=<<b>Supplier</b><br/><font point-size="10">farmer / wholesaler / distributor</font>>]
        PART [label=<<b>Retailer / Bakery</b><br/><font point-size="10">publishes near-expiry products</font>>]
        ADM  [label=<<b>Administrator</b><br/><font point-size="10">moderator</font>>]
    }

    SYS [label=<<font point-size="16"><b>Food Coop Platform</b></font><br/><br/>Collective food purchasing<br/>and food redistribution<br/><br/><font point-size="10"><i>Mobile app (Flutter) · Web portal (React)<br/>Backend (Java, Spring Boot) · PostgreSQL</i></font>>,
         fillcolor="#1F5FAD", color="#0B3D78", fontcolor="white", penwidth=2.5, width=3.2, height=2.2]

    subgraph cluster_ext {
        label=<<b>External systems</b>>; fontsize=13; style="rounded,dashed"; color="#BBBBBB"; fontcolor="#555555"
        node [fillcolor="#F2F2F2", color="#777777", fontcolor="#222222", width=2.3]
        KASPI [label=<<b>Kaspi QR</b><br/><font point-size="10">payment system<br/><i>(sandbox in MVP)</i></font>>]
        MAPS  [label=<<b>2GIS</b><br/><font point-size="10">maps and geocoding</font>>]
        FCM   [label=<<b>Firebase</b><br/><font point-size="10">push notifications (FCM)<br/>SMS codes (Phone Auth)</font>>]
        EGOV  [label=<<b>eGov / social assistance DB</b><br/><font point-size="10"><i>out of scope (FR-05)</i></font>>,
               style="rounded,dashed", fillcolor="white", color="#AAAAAA", fontcolor="#888888"]
    }

    FAM  -> SYS [label="1 · join pool, pay share,\nreserve food", dir=both]
    ORG  -> SYS [label="2 · create pool,\nconfirm hand-over (QR)"]
    SUP  -> SYS [label="3 · catalog, prices /\nconsolidated orders", dir=both]
    PART -> SYS [label="4 · publish near-expiry\nproducts"]
    ADM  -> SYS [label="5 · approve suppliers,\nverify social status"]

    SYS -> KASPI [label="6 · payment QR /\nconfirmation", dir=both]
    SYS -> MAPS  [label="7 · maps, geocoding"]
    SYS -> FCM   [label="8 · push, SMS codes"]
    SYS -> EGOV  [label="9 · not integrated", style=dashed, color="#AAAAAA", fontcolor="#888888"]
}
